{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning"
                                 }
                },
    "AllowedHosts":  "*",
    "ConnectionStrings":  {
                              "SqlServer":  "Server=sqlserver;Database=MediflowDb;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True"
                          },
    "Jwt":  {
                "Issuer":  "mediflow.api",
                "Audience":  "mediflow.web",
                "Secret":  "super-secret-key-change-me"
            },
    "AiService": {
      "BaseUrl": "http://localhost:8090"
    },
    "Serilog":  {
                    "Using":  [
                                  "Serilog.Sinks.Console"
                              ],
                    "MinimumLevel":  "Information",
                    "WriteTo":  [
                                    {
                                        "Name":  "Console"
                                    }
                                ],
                    "Enrich":  [
                                   "FromLogContext"
                               ]
                },
    "Observability":  {
                          "EnableStructuredLogs":  true,
                          "EnableRequestMetrics":  true
                      }
}
